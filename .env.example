# .env.example

# API key for your LLM provider (required for features that call external models)
OPENAI_API_KEY=
# Base URL for the LLM provider (OpenAI, OpenRouter, or self-hosted endpoint)
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Model identifier to use. Update according to your provider and plan.
AI_MODEL=google/gemma-4-26b-a4b-it:free

# Base directory for workspace operations (defaults to current working directory)
VERTEX_WORKSPACE_ROOT=

# Subprocess execution timeout (milliseconds)
SHELL_TIMEOUT_MS=60000

# Optional: enable debug logging (true/false)
VERTEX_DEBUG=false

# Optional: path to save browser agent screenshots (absolute or relative)
BROWSER_AGENT_SCREENSHOT_DIR=./.vertex/screenshots
