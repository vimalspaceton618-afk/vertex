{
  "name": "vertex-desktop",
  "productName": "Vertex",
  "version": "0.2.0",
  "private": true,
  "description": "Vertex desktop coding workspace",
  "author": "ARcHi",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "make": "electron-forge make",
    "test": "node --test deepseek.test.cjs workspace-edit.test.cjs workflow.test.cjs",
    "test:gui": "electron gui-smoke.cjs"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1"
  },
  "config": {
    "forge": {
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "setupExe": "VertexSetup.exe"
          }
        }
      ]
    }
  }
}
